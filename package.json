{
  "name": "slipstream",
  "version": "0.0.1",
  "private": true,
  "description": "A browser racing game with hand-written car physics, rule-based opponents and deterministic replays.",
  "keywords": [
    "typescript",
    "threejs",
    "game",
    "racing",
    "vehicle-physics",
    "procedural-generation"
  ],
  "license": "MIT",
  "author": "achugo",
  "repository": {
    "type": "git",
    "url": "https://github.com/achugo/slipstream.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
